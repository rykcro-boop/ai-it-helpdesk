      "id": "7b09a60e-2b89-4075-805d-94f56ba2bd2c",
      "name": "Insert row"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const t = $json;\nconst text = (t.description + \" \" + t.summary).toLowerCase();\n\nconst rank = { Low: 1, Medium: 2, High: 3, Critical: 4 };\nconst raise = (p) => { if (rank[p] > rank[t.priority]) t.priority = p; };\n\nconst criticalWords = [\"ransomware\",\"malware\",\"virus\",\"hacked\",\"data breach\",\"phishing\",\"unauthorized\",\"stolen\",\"server down\",\"network down\",\"all users\",\"everyone\"];\nconst highWords = [\"locked out\",\"cannot login\",\"can't login\",\"no internet\",\"email down\",\"cannot access\"];\n\nif (criticalWords.some(w => text.includes(w))) {\n  raise(\"Critical\");\n  t.escalation_required = true;\n} else if (highWords.some(w => text.includes(w))) {\n  raise(\"High\");\n}\n\nif (t.category === \"Security\") t.escalation_required = true;\n\nreturn { json: t };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
        -320
      ],
      "id": "d5b9dd9c-c695-4635-af41-0e8c7a0905fa",
      "name": "Apply Rules"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ticket = $('hooking new tickets').item.json.body || {};\n\nreturn {\n  json: {\n    ticket_id: \"HD-\" + Date.now(),\n    requester: String(ticket.requester || \"Unknown\"),\n    description: String(ticket.description || \"\"),\n    category: \"Other\",\n    priority: \"Medium\",\n    summary: \"AI unavailable - needs manual review\",\n    troubleshooting_steps: [],\n    steps_text: \"\",\n    escalation_required: true,\n    status: \"Needs Review\",\n    created_at: new Date().toISOString()\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        -128
      ],
      "id": "ce44c379-5608-4760-a257-e5624d0e8295",
      "name": "Fallback Ticket"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.message?.content;\nif (!raw) throw new Error(\"Ollama returned no message content.\");\n\nlet result;\ntry { result = JSON.parse(raw); }\ncatch { throw new Error(\"Gemma returned invalid JSON: \" + raw); }\n\nconst categories = [\"Networking\",\"Hardware\",\"Software\",\"Account\",\"Security\",\"Other\"];\nconst priorities = [\"Low\",\"Medium\",\"High\",\"Critical\"];\n\nif (!categories.includes(result.category)) result.category = \"Other\";\nif (!priorities.includes(result.priority)) result.priority = \"Medium\";\nif (typeof result.summary !== \"string\") result.summary = \"IT issue received for review.\";\nif (!Array.isArray(result.troubleshooting_steps)) result.troubleshooting_steps = [];\nresult.escalation_required = result.escalation_required === true;\n\nconst ticket = $('hooking new tickets').item.json.body || {};\nconst now = new Date().toISOString();\n\nreturn {\n  json: {\n    ticket_id: \"HD-\" + Date.now(),\n    requester: String(ticket.requester || \"Unknown\"),\n    description: String(ticket.description || \"\"),\n    ...result,\n    steps_text: result.troubleshooting_steps.map((s, i) => `${i + 1}. ${s}`).join(\"\\n\"),\n    status: \"Open\",\n    created_at: now\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        -320
      ],
      "id": "807e159e-ded3-4730-86eb-f4ea5b8cb647",
      "name": "Success Ticket"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst allowed = [\"Open\", \"In Progress\", \"Resolved\", \"Closed\"];\n\nif (!b.ticket_id) throw new Error(\"ticket_id is required.\");\nif (!allowed.includes(b.status)) {\n  throw new Error(\"status must be one of: \" + allowed.join(\", \"));\n}\n\nconst done = b.status === \"Resolved\" || b.status === \"Closed\";\n\nreturn {\n  json: {\n    ticket_id: String(b.ticket_id),\n    status: b.status,\n    resolution: String(b.resolution || \"\"),\n    resolved_at: done ? new Date().toISOString() : \"\"\n  }\n};"
      },
